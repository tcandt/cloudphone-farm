# Environment Variables Template for Phone Control Platform
# Note: Production compose (compose.production.yaml) loads secrets from ./secrets/ (postgres_password.txt, redis_password.txt, coturn_secret.txt)
NODE_ENV=production
POSTGRES_DB=phone_control_platform
POSTGRES_USER=pcp_user
COTURN_REALM=phonecontrol.io
VITE_FEATURE_RENTAL_STORE=false

# API Mode selection: 'mock' (standalone UI testing) or 'http' (connects to Go backend)
VITE_API_MODE=http
