{
	admin off
}

http://:8080 {
	header {
		X-PCP-Edge "caddy"
		X-Content-Type-Options "nosniff"
	}

	# Proxy WebSocket agent connections to backend cluster
	@agent_ws path /agent/v1/connect*
	handle @agent_ws {
		reverse_proxy 127.0.0.1:8081 127.0.0.1:8082 127.0.0.1:8083 {
			lb_policy round_robin
		}
	}

	# Proxy Browser WebSocket media stream
	@browser_media path /api/v1/devices/*/media/ws*
	handle @browser_media {
		reverse_proxy 127.0.0.1:8081 127.0.0.1:8082 127.0.0.1:8083 {
			lb_policy round_robin
		}
	}

	# Proxy REST API & health checks to backend cluster
	@api path /api/* /health/*
	handle @api {
		reverse_proxy 127.0.0.1:8081 127.0.0.1:8082 127.0.0.1:8083 {
			lb_policy round_robin
		}
	}
}

https://:8443 {
	tls internal

	header {
		X-PCP-Edge "caddy"
		X-Content-Type-Options "nosniff"
	}

	handle {
		reverse_proxy 127.0.0.1:8081 127.0.0.1:8082 127.0.0.1:8083 {
			lb_policy round_robin
		}
	}
}
