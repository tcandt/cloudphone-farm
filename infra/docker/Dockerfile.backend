# Multi-stage Dockerfile for Go Backend Service (Pinned Go 1.22.6)
FROM golang:1.22.6-alpine AS builder

WORKDIR /app

# Install build tools & CA certificates
RUN apk add --no-cache git ca-certificates

# Copy go.mod & go.sum for layer caching
COPY backend/go.mod backend/go.sum* ./
RUN go mod download

# Copy backend source code
COPY backend/ .

# Build static binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/pcp-server ./cmd/server

# Runner stage
FROM alpine:3.19 AS runner

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata wget

# Copy binary from builder
COPY --from=builder /app/pcp-server /app/pcp-server
COPY backend/db /app/db

EXPOSE 8080

ENTRYPOINT ["/app/pcp-server"]
